//@version=6

indicator("Auto Entry SL Target v9", overlay=true, max_lines_count=100, max_labels_count=100, dynamic_requests=true)

enum Direction
    BUY
    SELL

tradeTime = input.int(0, "Candle Time")

direction = input.enum(Direction.BUY, "Direction")

setupTf = input.string(
     "3",
     "Setup Timeframe",
     options=["1", "3", "5", "15", "30"]
     )

setupDate = input.time(
    timestamp("2026-11-20 00:00 +0530"),
    "Setup Date"
    )

// ─── Dashboard Settings ───────────────────────────────
showDashboard = input.bool(true, "Show Dashboard", group="Dashboard")

// ─── EMA Settings ─────────────────────────────────────
showEma   = input.bool(true, "Show EMA",   group="EMA")
emaLength = input.int(10,   "EMA Length", minval=1, group="EMA")

string timezone = "Asia/Kolkata"

timeValue = tradeTime

int hourInput = 0
int minuteInput = 0

if timeValue <= 99
    hourInput  := timeValue
    minuteInput := 0
else
    hourInput  := int(timeValue / 100)
    minuteInput := timeValue % 100

    if minuteInput >= 60
        int extraHours = int(minuteInput / 60)
        hourInput  := hourInput + extraHours
        minuteInput := minuteInput % 60

setupTimestamp = timestamp(
     timezone,
     year(setupDate, timezone),
     month(setupDate, timezone),
     dayofmonth(setupDate, timezone),
     hourInput,
     minuteInput
     )


//=========================================================
// FIND SETUP CANDLE
//=========================================================

findSetup(_targetTime) =>
    bool found      = time == _targetTime
    float setupHigh = found ? high : na
    float setupLow  = found ? low  : na
    int   setupTime = found ? time : na
    [found, setupHigh, setupLow, setupTime]

[setupFoundRaw, setupHighRaw, setupLowRaw, setupTimeRaw] = request.security(
     syminfo.tickerid, setupTf, findSetup(setupTimestamp),
     lookahead=barmerge.lookahead_off
     )


//=========================================================
// SAVE SETUP
//=========================================================

var float finalSetupHigh = na
var float finalSetupLow  = na
var int   finalSetupTime = na
var bool  setupSaved     = false

if setupFoundRaw and not setupSaved
    finalSetupHigh := setupHighRaw
    finalSetupLow  := setupLowRaw
    finalSetupTime := setupTimeRaw
    setupSaved     := true

int setupEndTime        = finalSetupTime + timeframe.in_seconds(setupTf) * 1000
int checkWindowDuration = 24 * 60 * 60 * 1000
int checkWindowEnd      = setupEndTime + checkWindowDuration
int purpleCheckStartTime = finalSetupTime + 4 * 60 * 1000


//=========================================================
// LEVEL VARIABLES
//=========================================================

var float entryPrice   = na
var float slPrice      = na
var float targetPrice  = na
var float target2Price = na
var float candleRange  = na

var bool levelsDrawn     = false
var int  levelsStartBar  = na
var int  levelsStartTime = na
var int  levelsLineEndTime = na
var bool slLocked        = false
var bool target1Touched  = false
var bool target2Touched  = false

var label candleLabel = na
var bool  slBroken    = false
var int   slBrokenTime = na


//=========================================================
// LINE VARIABLES
//=========================================================

var line  slLine       = na
var line  target1Line  = na
var line  target2Line  = na
var line  yellowLine   = na
var float yellowLinePrice = na
var label target1Label = na
var label target2Label = na
var label slLabel      = na


//=========================================================
// CALCULATE & DRAW LEVELS
//=========================================================

if setupSaved and not levelsDrawn

    candleRange := finalSetupHigh - finalSetupLow

    if direction == Direction.BUY
        entryPrice   := finalSetupHigh
        slPrice      := finalSetupLow
        targetPrice  := finalSetupHigh + candleRange
        target2Price := finalSetupHigh + candleRange * 2
    else
        entryPrice   := finalSetupLow
        slPrice      := finalSetupHigh
        targetPrice  := finalSetupLow - candleRange
        target2Price := finalSetupLow - candleRange * 2

    levelsStartBar     := bar_index
    levelsStartTime    := time
    levelsLineEndTime  := time + (timeframe.in_seconds() * 1000 * 20)

    line.new(x1=levelsStartTime, y1=entryPrice, x2=levelsLineEndTime, y2=entryPrice,
         xloc=xloc.bar_time, color=color.blue, width=1, style=line.style_solid, extend=extend.none)

    slLine := line.new(x1=levelsStartTime, y1=slPrice, x2=levelsLineEndTime, y2=slPrice,
         xloc=xloc.bar_time, color=color.red, width=1, style=line.style_dotted, extend=extend.none)

    box.new(left=levelsStartTime, top=math.max(entryPrice, slPrice),
         right=levelsLineEndTime, bottom=math.min(entryPrice, slPrice),
         xloc=xloc.bar_time, border_color=color.new(color.red, 50), border_width=1,
         border_style=line.style_solid, bgcolor=color.new(color.red, 90), extend=extend.none)

    bool isNaturalGas = str.contains(syminfo.ticker, "NATURALGAS") or str.contains(syminfo.ticker, "NG")
    string rangeText  = isNaturalGas ? str.tostring(candleRange * 100, "#.##") : str.tostring(candleRange, "#.##")
    label.new(x=levelsStartBar + 10, y=slPrice, text=rangeText, xloc=xloc.bar_index,
         style=label.style_label_right, color=color.red, textcolor=color.white, size=size.small)

    target1Line := line.new(x1=levelsStartTime, y1=targetPrice, x2=levelsLineEndTime, y2=targetPrice,
         xloc=xloc.bar_time, color=color.green, width=1, style=line.style_dotted, extend=extend.none)

    box.new(left=levelsStartTime, top=math.max(entryPrice, targetPrice),
         right=levelsLineEndTime, bottom=math.min(entryPrice, targetPrice),
         xloc=xloc.bar_time, border_color=color.new(color.green, 50), border_width=1,
         border_style=line.style_solid, bgcolor=color.new(color.green, 90), extend=extend.none)

    target2Line := line.new(x1=levelsStartTime, y1=target2Price, x2=levelsLineEndTime, y2=target2Price,
         xloc=xloc.bar_time, color=color.orange, width=1, style=line.style_dotted, extend=extend.none)

    box.new(left=levelsStartTime, top=math.max(targetPrice, target2Price),
         right=levelsLineEndTime, bottom=math.min(targetPrice, target2Price),
         xloc=xloc.bar_time, border_color=color.new(color.orange, 50), border_width=1,
         border_style=line.style_solid, bgcolor=color.new(color.orange, 90), extend=extend.none)

    levelsDrawn := true


//=========================================================
// STOP LOSS HIT CHECK
//=========================================================

hitStopLoss(_setupEndTime, _slPrice, _direction, _windowEnd) =>
    var bool done       = false
    var int  resultTime = na

    if not na(_setupEndTime) and time >= _setupEndTime and time <= _windowEnd and not done
        if _direction == Direction.BUY
            if barstate.isconfirmed and close <= _slPrice
                resultTime := time_close
                done       := true
        else
            if barstate.isconfirmed and close >= _slPrice
                resultTime := time_close
                done       := true
    [resultTime]


//=========================================================
// TARGET TOUCH: DOTTED TO SOLID
//=========================================================

if setupSaved and levelsDrawn

    if not slLocked
        [sl1mTime] = request.security(
             syminfo.tickerid, "1",
             hitStopLoss(setupEndTime, slPrice, direction, checkWindowEnd),
             lookahead=barmerge.lookahead_off
             )

        if not na(sl1mTime) and not na(slLine)
            line.set_style(slLine, line.style_solid)
            line.set_width(slLine, 1)
            slLocked    := true
            slBroken    := true
            slBrokenTime := sl1mTime
            if na(slLabel)
                slLabel := label.new(x=levelsStartTime, y=slPrice, text="SL",
                     xloc=xloc.bar_time, style=label.style_label_right,
                     color=color.red, textcolor=color.white, size=size.small)

    if direction == Direction.BUY

        if time >= setupEndTime and time <= checkWindowEnd and not target1Touched and not na(target1Line)
            if high >= targetPrice - syminfo.mintick * 0.5
                line.set_style(target1Line, line.style_solid)
                line.set_width(target1Line, 1)
                target1Touched := true
                line.set_color(target1Line, color.new(color.green, 100))
                line.set_width(target1Line, 0)
                if na(target1Label)
                    target1Label := label.new(x=levelsStartTime, y=targetPrice, text="T1",
                         xloc=xloc.bar_time, style=label.style_label_right,
                         color=color.green, textcolor=color.white, size=size.small)

        if time >= setupEndTime and time <= checkWindowEnd and not target2Touched and not na(target2Line) and target1Touched
            if high >= target2Price - syminfo.mintick * 0.5
                line.set_style(target2Line, line.style_solid)
                line.set_width(target2Line, 1)
                target2Touched := true
                if na(target2Label)
                    target2Label := label.new(x=levelsStartTime, y=target2Price, text="T2",
                         xloc=xloc.bar_time, style=label.style_label_right,
                         color=color.orange, textcolor=color.white, size=size.small)

    else

        if time >= setupEndTime and time <= checkWindowEnd and not target1Touched and not na(target1Line)
            if low <= targetPrice + syminfo.mintick * 0.5
                line.set_style(target1Line, line.style_solid)
                line.set_width(target1Line, 1)
                target1Touched := true
                line.set_color(target1Line, color.new(color.green, 100))
                line.set_width(target1Line, 0)
                if na(target1Label)
                    target1Label := label.new(x=levelsStartTime, y=targetPrice, text="T1",
                         xloc=xloc.bar_time, style=label.style_label_right,
                         color=color.green, textcolor=color.white, size=size.small)

        if time >= setupEndTime and time <= checkWindowEnd and not target2Touched and not na(target2Line) and target1Touched
            if low <= target2Price + syminfo.mintick * 0.5
                line.set_style(target2Line, line.style_solid)
                line.set_width(target2Line, 1)
                target2Touched := true
                if na(target2Label)
                    target2Label := label.new(x=levelsStartTime, y=target2Price, text="T2",
                         xloc=xloc.bar_time, style=label.style_label_right,
                         color=color.orange, textcolor=color.white, size=size.small)


//=========================================================
isEntryBreakoutPrice(_entry, _price, _direction) =>
    _direction == Direction.BUY ? _price > _entry : _price < _entry


//=========================================================
// DIRECT BREAKOUT
//=========================================================

directBreakout(_entry, _setupTime, _direction, _windowEnd) =>
    var bool  done        = false
    var int   resultTime  = na
    var float resultPrice = na

    if not na(_setupTime) and time >= _setupTime and time <= _windowEnd and not done
        bool valid = isEntryBreakoutPrice(_entry, close, _direction)
        if valid and barstate.isconfirmed
            resultTime  := time_close
            resultPrice := close
            done        := true
    [resultTime, resultPrice]


//=========================================================
// 1M TWO-CANDLE BREAKOUT CONFIRMATION (BODY ONLY)
//=========================================================

twoStepBreakout(_entry, _setupTime, _direction, _windowEnd) =>
    var float firstCandleHigh = na
    var float firstCandleLow  = na
    var bool  firstFound      = false
    var bool  done            = false
    var int   resultTime      = na
    var float resultPrice     = na

    if not na(_setupTime) and time >= _setupTime and time <= _windowEnd and not done
        float bodyHigh = math.max(open, close)
        float bodyLow  = math.min(open, close)

        if barstate.isconfirmed
            if _direction == Direction.BUY
                if not firstFound and bodyHigh > _entry
                    firstCandleHigh := bodyHigh
                    firstFound      := true
                else if firstFound and close > firstCandleHigh
                    resultTime  := time_close
                    resultPrice := close
                    done        := true
            else
                if not firstFound and bodyLow < _entry
                    firstCandleLow := bodyLow
                    firstFound     := true
                else if firstFound and close < firstCandleLow
                    resultTime  := time_close
                    resultPrice := close
                    done        := true
    [resultTime, resultPrice]


//=========================================================
// 1M ENTRY BREAKOUT CONFIRMATION (YELLOW)
//=========================================================

oneMinuteEntryBreakout(_entry, _target, _setupEndTime, _direction, _windowEnd) =>
    var bool  done        = false
    var int   resultTime  = na
    var float resultPrice = na

    if not na(_setupEndTime) and time >= _setupEndTime and time <= _windowEnd and not done
        float bodyHigh = math.max(open, close)
        float bodyLow  = math.min(open, close)
        bool breakout  = false

        if _direction == Direction.BUY
            breakout := bodyHigh > _entry and close <= _target
        else
            breakout := bodyLow < _entry and close >= _target

        if breakout and barstate.isconfirmed
            resultTime  := time
            resultPrice := close
            done        := true
    [resultTime, resultPrice]


int   yellowConfirmTime  = na
float yellowConfirmPrice = na

//=========================================================
// PURPLE CONFIRMATION VARIABLES
//=========================================================

int   confirmTimeA  = na
float confirmPriceA = na
int   confirmTimeB  = na
float confirmPriceB = na
int   confirmTimeC  = na
float confirmPriceC = na


//=========================================================
// 1M SETUP - YELLOW LINE
//=========================================================

if setupSaved and levelsDrawn and setupTf == "1"
    [oneMinConfirmTime, oneMinConfirmPrice] = request.security(
         syminfo.tickerid, "1",
         oneMinuteEntryBreakout(entryPrice, targetPrice, finalSetupTime, direction, checkWindowEnd),
         lookahead=barmerge.lookahead_off
         )

    if not na(oneMinConfirmTime) and not na(oneMinConfirmPrice) and oneMinConfirmTime >= setupEndTime and oneMinConfirmTime <= checkWindowEnd
        yellowConfirmTime  := oneMinConfirmTime
        yellowConfirmPrice := oneMinConfirmPrice
    else
        yellowConfirmTime  := na
        yellowConfirmPrice := na


//=========================================================
// 3M & 5M SETUP - YELLOW & PURPLE
//=========================================================

if setupSaved and levelsDrawn and (setupTf == "3" or setupTf == "5")

    [oneMinuteCloseTime, oneMinuteClosePrice] = request.security(
         syminfo.tickerid, "1",
         directBreakout(entryPrice, setupEndTime, direction, checkWindowEnd),
         lookahead=barmerge.lookahead_off
         )

    if not na(oneMinuteCloseTime) and not na(oneMinuteClosePrice)
        yellowConfirmTime  := oneMinuteCloseTime
        yellowConfirmPrice := oneMinuteClosePrice

    if setupTf == "3"
        [threeTime, threePrice] = request.security(
             syminfo.tickerid, "3",
             directBreakout(entryPrice, setupEndTime, direction, checkWindowEnd),
             lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_on
             )
        confirmTimeA  := threeTime
        confirmPriceA := threePrice
    else
        [fiveTime, fivePrice] = request.security(
             syminfo.tickerid, "5",
             directBreakout(entryPrice, purpleCheckStartTime, direction, checkWindowEnd),
             lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_on
             )
        confirmTimeA  := fiveTime
        confirmPriceA := fivePrice

    confirmTimeB  := na
    confirmPriceB := na
    confirmTimeC  := na
    confirmPriceC := na


//=========================================================
// 15M SETUP - PURPLE
//=========================================================

if setupSaved and levelsDrawn and setupTf == "15"

    [oneMinuteCloseTime15, oneMinuteClosePrice15] = request.security(
         syminfo.tickerid, "1",
         directBreakout(entryPrice, setupEndTime, direction, checkWindowEnd),
         lookahead=barmerge.lookahead_off
         )

    if not na(oneMinuteCloseTime15) and not na(oneMinuteClosePrice15)
        yellowConfirmTime  := oneMinuteCloseTime15
        yellowConfirmPrice := oneMinuteClosePrice15

    [fifteenTime, fifteenPrice] = request.security(
         syminfo.tickerid, "15",
         directBreakout(entryPrice, setupEndTime, direction, checkWindowEnd),
         lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_on
         )
    confirmTimeA  := fifteenTime
    confirmPriceA := fifteenPrice
    confirmTimeB  := na
    confirmPriceB := na
    confirmTimeC  := na
    confirmPriceC := na


//=========================================================
// 30M SETUP - PURPLE
//=========================================================

if setupSaved and levelsDrawn and setupTf == "30"

    [fiveTime30, fivePrice30] = request.security(
         syminfo.tickerid, "5",
         directBreakout(entryPrice, setupEndTime, direction, checkWindowEnd),
         lookahead=barmerge.lookahead_off
         )

    [thirtyTime, thirtyPrice] = request.security(
         syminfo.tickerid, "30",
         directBreakout(entryPrice, setupEndTime, direction, checkWindowEnd),
         lookahead=barmerge.lookahead_off
         )

    bool valid5m = not na(fiveTime30) and not na(fivePrice30) and
         fiveTime30 > setupEndTime and fiveTime30 <= checkWindowEnd and
         isEntryBreakoutPrice(entryPrice, fivePrice30, direction)

    if valid5m
        confirmTimeA  := fiveTime30
        confirmPriceA := fivePrice30
        confirmTimeB  := na
        confirmPriceB := na
        confirmTimeC  := na
        confirmPriceC := na
    else
        bool valid30m = not na(thirtyTime) and not na(thirtyPrice) and
             thirtyTime > setupEndTime and thirtyTime <= checkWindowEnd and
             isEntryBreakoutPrice(entryPrice, thirtyPrice, direction)

        confirmTimeA  := valid30m ? thirtyTime  : na
        confirmPriceA := valid30m ? thirtyPrice : na
        confirmTimeB  := na
        confirmPriceB := na
        confirmTimeC  := na
        confirmPriceC := na


//=========================================================
// SELECT PURPLE CONFIRMATION
//=========================================================

selectConfirmation(_timeA, _priceA, _timeB, _priceB, _timeC, _priceC,
     _entry, _setupTime, _windowEnd, _direction) =>

    bool validA = not na(_timeA) and not na(_priceA) and
         _timeA > _setupTime and _timeA <= _windowEnd and
         isEntryBreakoutPrice(_entry, _priceA, _direction)

    bool validB = not na(_timeB) and not na(_priceB) and
         _timeB > _setupTime and _timeB <= _windowEnd and
         isEntryBreakoutPrice(_entry, _priceB, _direction)

    bool validC = not na(_timeC) and not na(_priceC) and
         _timeC > _setupTime and _timeC <= _windowEnd and
         isEntryBreakoutPrice(_entry, _priceC, _direction)

    int   selectedTime  = na
    float selectedPrice = na

    if validA
        selectedTime  := _timeA
        selectedPrice := _priceA

    if validB and (na(selectedTime) or _timeB < selectedTime)
        selectedTime  := _timeB
        selectedPrice := _priceB

    if validC and (na(selectedTime) or _timeC < selectedTime)
        selectedTime  := _timeC
        selectedPrice := _priceC

    [selectedTime, selectedPrice]


//=========================================================
// PURPLE LINE
//=========================================================

var bool  breakoutDone       = false
var int   lockedConfirmTime  = na
var float lockedConfirmPrice = na
var bool  confirmTargetDrawn = false

if setupSaved and levelsDrawn and not breakoutDone

    [selectedTime, selectedPrice] = selectConfirmation(
         confirmTimeA, confirmPriceA, confirmTimeB, confirmPriceB, confirmTimeC, confirmPriceC,
         entryPrice, setupEndTime, checkWindowEnd, direction
         )

    if not na(selectedTime) and not na(selectedPrice)

        bool validPurpleRange = false
        if direction == Direction.BUY
            validPurpleRange := selectedPrice > entryPrice and selectedPrice <= targetPrice + syminfo.mintick
        else
            validPurpleRange := selectedPrice < entryPrice and selectedPrice >= targetPrice - syminfo.mintick

        if validPurpleRange
            lockedConfirmTime  := selectedTime
            lockedConfirmPrice := selectedPrice

            line.new(x1=levelsStartTime, y1=lockedConfirmPrice, x2=levelsLineEndTime, y2=lockedConfirmPrice,
                 xloc=xloc.bar_time, color=color.purple, width=1, style=line.style_solid, extend=extend.none)

            label.new(x=levelsStartTime, y=lockedConfirmPrice, text=setupTf + "M",
                 xloc=xloc.bar_time, style=label.style_label_right,
                 color=color.purple, textcolor=color.white, size=size.small)

        breakoutDone := true


//=========================================================
// YELLOW LINE (1-minute confirmation)
//=========================================================

if setupSaved and levelsDrawn and not na(yellowConfirmTime) and not na(yellowConfirmPrice) and
     yellowConfirmTime >= setupEndTime and yellowConfirmTime <= checkWindowEnd and na(yellowLine)

    bool validYellowRange = false
    if direction == Direction.BUY
        validYellowRange := yellowConfirmPrice > entryPrice and yellowConfirmPrice <= targetPrice + syminfo.mintick
    else
        validYellowRange := yellowConfirmPrice < entryPrice and yellowConfirmPrice >= targetPrice - syminfo.mintick

    if validYellowRange
        yellowLinePrice := yellowConfirmPrice

        yellowLine := line.new(x1=levelsStartTime, y1=yellowConfirmPrice, x2=levelsLineEndTime, y2=yellowConfirmPrice,
             xloc=xloc.bar_time, color=color.rgb(255, 165, 0), width=1, style=line.style_solid, extend=extend.none)

        label.new(x=levelsStartTime, y=yellowConfirmPrice, text="1M",
             xloc=xloc.bar_time, style=label.style_label_right,
             color=color.rgb(255, 165, 0), textcolor=color.white, size=size.small)

plot(entryPrice,        title="Entry",  color=color.blue,              display=display.price_scale)
plot(lockedConfirmPrice, title="Purple", color=color.purple,            display=display.price_scale)
plot(yellowLinePrice,    title="Yellow", color=color.rgb(255, 165, 0),  display=display.price_scale)


//=========================================================
// CONFIRM TARGET LINE
//=========================================================

if setupSaved and levelsDrawn and not confirmTargetDrawn

    int   firstConfirmTime  = na
    float firstConfirmPrice = na

    if not na(yellowConfirmTime) and not na(lockedConfirmTime)
        if yellowConfirmTime < lockedConfirmTime
            firstConfirmTime  := yellowConfirmTime
            firstConfirmPrice := yellowConfirmPrice
        else
            firstConfirmTime  := lockedConfirmTime
            firstConfirmPrice := lockedConfirmPrice
    else if not na(yellowConfirmTime)
        firstConfirmTime  := yellowConfirmTime
        firstConfirmPrice := yellowConfirmPrice
    else if not na(lockedConfirmTime)
        firstConfirmTime  := lockedConfirmTime
        firstConfirmPrice := lockedConfirmPrice

    if not na(firstConfirmTime) and not na(firstConfirmPrice)
        float confirmToSL      = math.abs(firstConfirmPrice - slPrice)
        float confirmTargetPrice = direction == Direction.BUY ?
             firstConfirmPrice + confirmToSL :
             firstConfirmPrice - confirmToSL

        line.new(x1=levelsStartTime, y1=confirmTargetPrice, x2=levelsLineEndTime, y2=confirmTargetPrice,
             xloc=xloc.bar_time, color=color.rgb(0, 150, 255), width=1,
             style=line.style_solid, extend=extend.none)

        confirmTargetDrawn := true


//=========================================================
// EMA BREAK DETECTION (entry ke baad pehla EMA cross)
//=========================================================

emaValue = ta.ema(close, emaLength)

var float emaCrossPrice  = na
var bool  emaCrossDone   = false
var bool  emaCrossAbove  = false
var float emaPeakPrice   = na
var float emaBreakPoints = na

if setupSaved and levelsDrawn and not emaCrossDone and time >= setupEndTime and time <= checkWindowEnd and barstate.isconfirmed
    if direction == Direction.BUY
        if close > emaValue
            emaCrossAbove := true
            emaPeakPrice  := na(emaPeakPrice) ? high : math.max(emaPeakPrice, high)
        if emaCrossAbove and close < emaValue
            emaCrossPrice := close
            emaCrossDone  := true
    else
        if close < emaValue
            emaCrossAbove := true
            emaPeakPrice  := na(emaPeakPrice) ? low : math.min(emaPeakPrice, low)
        if emaCrossAbove and close > emaValue
            emaCrossPrice := close
            emaCrossDone  := true

if not na(emaCrossPrice) and not na(entryPrice)
    emaBreakPoints := math.abs(emaCrossPrice - entryPrice)


//=========================================================
// DASHBOARD TABLE
//=========================================================

if barstate.islast and setupSaved and showDashboard

    bool isNG = str.contains(syminfo.ticker, "NATURALGAS") or str.contains(syminfo.ticker, "NG")

    string setupDateStr = str.format("{0,date,dd-MMM-yyyy}", setupDate)
    string dirText      = direction == Direction.BUY ? "BUY" : "SELL"
    string entryStr     = isNG ? str.tostring(entryPrice,   "#.####") : str.tostring(entryPrice,   "#.##")
    string slStr        = isNG ? str.tostring(slPrice,      "#.####") : str.tostring(slPrice,      "#.##")
    string t1Str        = isNG ? str.tostring(targetPrice,  "#.####") : str.tostring(targetPrice,  "#.##")
    string t2Str        = isNG ? str.tostring(target2Price, "#.####") : str.tostring(target2Price, "#.##")
    string rangeStr     = isNG ? str.tostring(candleRange * 100, "#.##") + " pts" : str.tostring(candleRange, "#.##") + " pts"

    string t1Status = target1Touched ? "HIT"  : "Pending"
    string t2Status = target2Touched ? "HIT"  : "Pending"
    string slStatus = slBroken       ? "HIT"  : "Pending"
    color  t1Bg     = target1Touched ? color.new(color.green,  30) : color.new(color.gray, 60)
    color  t2Bg     = target2Touched ? color.new(color.orange, 30) : color.new(color.gray, 60)
    color  slBg     = slBroken       ? color.new(color.red,    30) : color.new(color.gray, 60)

    string resultText = slBroken ? "SL Hit" : target2Touched ? "T2 Hit!" : target1Touched ? "T1 Hit" : "In Play"
    color  resultBg   = slBroken ? color.new(color.red, 50) : target2Touched ? color.new(color.orange, 50) : target1Touched ? color.new(color.green, 50) : color.new(color.gray, 60)

    color rowBg = color.new(color.black, 30)
    color hdrBg = color.new(color.navy, 10)

    table dash = table.new(
         position.top_right, 2, 10,
         bgcolor      = color.new(color.black, 10),
         border_color = color.new(color.white, 50),
         border_width = 1,
         frame_color  = color.new(color.white, 30),
         frame_width  = 2
         )

    table.cell(dash, 0, 0, "TRADE DASHBOARD", text_color=color.white, text_size=size.normal, bgcolor=hdrBg, text_halign=text.align_center)
    table.cell(dash, 1, 0, setupDateStr,       text_color=color.white, text_size=size.normal, bgcolor=hdrBg, text_halign=text.align_center)
    table.cell(dash, 0, 1, "Direction",        text_color=color.white, text_size=size.small,  bgcolor=rowBg)
    table.cell(dash, 1, 1, dirText,            text_color=color.white, text_size=size.small,  bgcolor=rowBg, text_halign=text.align_center)
    table.cell(dash, 0, 2, "Entry",            text_color=color.white, text_size=size.small,  bgcolor=rowBg)
    table.cell(dash, 1, 2, entryStr,           text_color=color.white, text_size=size.small,  bgcolor=rowBg, text_halign=text.align_center)
    table.cell(dash, 0, 3, "Range (SL)",       text_color=color.white, text_size=size.small,  bgcolor=rowBg)
    table.cell(dash, 1, 3, rangeStr,           text_color=color.white, text_size=size.small,  bgcolor=rowBg, text_halign=text.align_center)
    table.cell(dash, 0, 4, "SL @ " + slStr,   text_color=color.white, text_size=size.small,  bgcolor=rowBg)
    table.cell(dash, 1, 4, slStatus,           text_color=color.white, text_size=size.small,  bgcolor=slBg,  text_halign=text.align_center)
    table.cell(dash, 0, 5, "T1 @ " + t1Str,   text_color=color.white, text_size=size.small,  bgcolor=rowBg)
    table.cell(dash, 1, 5, t1Status,           text_color=color.white, text_size=size.small,  bgcolor=t1Bg,  text_halign=text.align_center)
    table.cell(dash, 0, 6, "T2 @ " + t2Str,   text_color=color.white, text_size=size.small,  bgcolor=rowBg)
    table.cell(dash, 1, 6, t2Status,           text_color=color.white, text_size=size.small,  bgcolor=t2Bg,  text_halign=text.align_center)
    table.cell(dash, 0, 7, "Result",           text_color=color.white, text_size=size.small,  bgcolor=rowBg)
    table.cell(dash, 1, 7, resultText,         text_color=color.white, text_size=size.small,  bgcolor=resultBg, text_halign=text.align_center)
    table.cell(dash, 0, 8, "Setup TF",         text_color=color.white, text_size=size.small,  bgcolor=rowBg)
    table.cell(dash, 1, 8, setupTf + "M",      text_color=color.white, text_size=size.small,  bgcolor=rowBg, text_halign=text.align_center)

    // Row 9 — Entry to EMA Break Points
    bool   isNG2        = str.contains(syminfo.ticker, "NATURALGAS") or str.contains(syminfo.ticker, "NG")
    string emaBreakStr  = na(emaBreakPoints) ? "Pending" : (isNG2 ? str.tostring(emaBreakPoints * 100, "#.##") : str.tostring(emaBreakPoints, "#.##")) + " pts"
    color  emaBreakBg   = na(emaBreakPoints) ? color.new(color.gray, 60) : color.new(color.teal, 30)
    table.cell(dash, 0, 9, "Entry→EMA Break",  text_color=color.white, text_size=size.small,  bgcolor=rowBg)
    table.cell(dash, 1, 9, emaBreakStr,         text_color=color.white, text_size=size.small,  bgcolor=emaBreakBg, text_halign=text.align_center)


//=========================================================
// EMA PLOT
//=========================================================

plot(emaValue, title="EMA", color=showEma ? color.blue : na, linewidth=2, style=plot.style_stepline)
