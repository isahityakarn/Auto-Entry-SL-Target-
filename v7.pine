//@version=6

indicator("Auto Entry SL Target v7", overlay=true, max_lines_count=100, max_labels_count=100, dynamic_requests=true)

enum Direction
    BUY
    SELL

tradeTime = input.int(0, "Candle Time")

direction = input.enum(Direction.BUY, "Direction")

setupTf = input.string(
     "3",
     "Setup Timeframe",
     options=["1", "3", "5", "30"]
     )

setupDate = input.time(
    timestamp("2026-11-06 00:00 +0530"),
    "Setup Date"
    )

string timezone = "Asia/Kolkata"

timeValue = tradeTime

int hourInput = 0
int minuteInput = 0

if timeValue <= 99
    hourInput := timeValue
    minuteInput := 0
else
    hourInput := int(timeValue / 100)
    minuteInput := timeValue % 100
    
    // Handle minute overflow: if minutes >= 60, convert to next hour
    if minuteInput >= 60
        int extraHours = int(minuteInput / 60)
        hourInput := hourInput + extraHours
        minuteInput := minuteInput % 60

setupTimestamp = timestamp(
     timezone,
     year(setupDate, timezone),
     month(setupDate, timezone),
     dayofmonth(setupDate, timezone),
     hourInput,
     minuteInput
     )


//=========================================================
// FIND SETUP CANDLE
//=========================================================

findSetup(_targetTime) =>
    bool found = time == _targetTime
    float setupHigh = found ? high : na
    float setupLow = found ? low : na
    int setupTime = found ? time : na

    [found, setupHigh, setupLow, setupTime]

[setupFoundRaw, setupHighRaw, setupLowRaw, setupTimeRaw] = request.security(syminfo.tickerid, setupTf, findSetup(setupTimestamp), lookahead=barmerge.lookahead_off)


//=========================================================
// SAVE SETUP
//=========================================================

var float finalSetupHigh = na
var float finalSetupLow = na
var int finalSetupTime = na
var bool setupSaved = false

if setupFoundRaw and not setupSaved
    finalSetupHigh := setupHighRaw
    finalSetupLow := setupLowRaw
    finalSetupTime := setupTimeRaw
    setupSaved := true

int setupEndTime = finalSetupTime + timeframe.in_seconds(setupTf) * 1000
int checkWindowDuration = 24 * 60 * 60 * 1000
int checkWindowEnd = setupEndTime + checkWindowDuration
int purpleCheckStartTime = finalSetupTime + 4 * 60 * 1000  // 9 minutes after setup start (for 5M setup purple line)


//=========================================================
// LEVEL VARIABLES
//=========================================================

var float entryPrice = na
var float slPrice = na
var float targetPrice = na
var float target2Price = na
var float candleRange = na

var bool levelsDrawn = false
var int levelsStartBar = na
var int levelsStartTime = na
var int levelsLineEndTime = na
var bool slLocked = false
var bool target1Touched = false
var bool target2Touched = false

var label candleLabel = na


//=========================================================
// LINE VARIABLES
//=========================================================

var line slLine = na
var line target1Line = na
var line target2Line = na
var line yellowLine = na
var float yellowLinePrice = na


//=========================================================
// CALCULATE & DRAW LEVELS
//=========================================================

if setupSaved and not levelsDrawn

    candleRange := finalSetupHigh - finalSetupLow

    if direction == Direction.BUY

        entryPrice := finalSetupHigh
        slPrice := finalSetupLow

        targetPrice := finalSetupHigh + candleRange
        target2Price := finalSetupHigh + candleRange * 2

    else

        entryPrice := finalSetupLow
        slPrice := finalSetupHigh

        targetPrice := finalSetupLow - candleRange
        target2Price := finalSetupLow - candleRange * 2

    levelsStartBar := bar_index
    levelsStartTime := time
    // Calculate end time as 20 candles after entry
    levelsLineEndTime := time + (timeframe.in_seconds() * 1000 * 20)

    line.new(
            x1=levelsStartTime,
         y1=entryPrice,
                x2=levelsLineEndTime,
         y2=entryPrice,
            xloc=xloc.bar_time,
         color=color.blue,
         width=1,
         style=line.style_solid,
            extend=extend.none
         )

    slLine := line.new(
            x1=levelsStartTime,
         y1=slPrice,
            x2=levelsLineEndTime,
         y2=slPrice,
            xloc=xloc.bar_time,
         color=color.red,
         width=1,
         style=line.style_dotted,
            extend=extend.none
         )
    
    // Draw rectangular box between entry and SL (gray)
    box.new(
         left=levelsStartTime,
         top=math.max(entryPrice, slPrice),
         right=levelsLineEndTime,
         bottom=math.min(entryPrice, slPrice),
         xloc=xloc.bar_time,
         border_color=color.new(color.red, 50),
         border_width=1,
         border_style=line.style_solid,
         bgcolor=color.new(color.red, 90),
         extend=extend.none
         )
    
    // Check if symbol is Natural Gas
    bool isNaturalGas = str.contains(syminfo.ticker, "NATURALGAS") or str.contains(syminfo.ticker, "NG")
    
    // For Natural Gas, convert to points (multiply by 100), otherwise show regular price
    string rangeText = isNaturalGas ? str.tostring(candleRange * 100, "#.##") : str.tostring(candleRange, "#.##")
    
    // Show SL label 10 candles after the entry line
    label.new(x=levelsStartBar + 10, y=slPrice, text=rangeText, xloc=xloc.bar_index, style=label.style_label_right, color=color.red, textcolor=color.white, size=size.small)

    target1Line := line.new(
            x1=levelsStartTime,
         y1=targetPrice,
            x2=levelsLineEndTime,
         y2=targetPrice,
            xloc=xloc.bar_time,
         color=color.green,
         width=1,
         style=line.style_dotted,
            extend=extend.none
         )
    
    label.new(x=levelsStartTime, y=targetPrice, text="T1", xloc=xloc.bar_time, style=label.style_label_right, color=color.green, textcolor=color.white, size=size.small)
    
    // Draw rectangular box between Entry and T1 (green)
    box.new(
         left=levelsStartTime,
         top=math.max(entryPrice, targetPrice),
         right=levelsLineEndTime,
         bottom=math.min(entryPrice, targetPrice),
         xloc=xloc.bar_time,
         border_color=color.new(color.green, 50),
         border_width=1,
         border_style=line.style_solid,
         bgcolor=color.new(color.green, 90),
         extend=extend.none
         )

    target2Line := line.new(
            x1=levelsStartTime,
         y1=target2Price,
            x2=levelsLineEndTime,
         y2=target2Price,
            xloc=xloc.bar_time,
         color=color.orange,
         width=1,
         style=line.style_dotted,
            extend=extend.none
         )
    
    label.new(x=levelsStartTime, y=target2Price, text="T2", xloc=xloc.bar_time, style=label.style_label_right, color=color.orange, textcolor=color.white, size=size.small)

    // Draw rectangular box between T1 and T2 (orange)
    box.new(
         left=levelsStartTime,
         top=math.max(targetPrice, target2Price),
         right=levelsLineEndTime,
         bottom=math.min(targetPrice, target2Price),
         xloc=xloc.bar_time,
         border_color=color.new(color.orange, 50),
         border_width=1,
         border_style=line.style_solid,
         bgcolor=color.new(color.orange, 90),
         extend=extend.none
         )

    levelsDrawn := true

//=========================================================
// STOP LOSS HIT CHECK
//=========================================================

hitStopLoss(_setupEndTime, _slPrice, _direction, _windowEnd) =>
    var bool done = false
    var int resultTime = na

    if not na(_setupEndTime) and time >= _setupEndTime and time <= _windowEnd and not done
        if _direction == Direction.BUY
            if barstate.isconfirmed and close <= _slPrice
                resultTime := time_close
                done := true
        else
            if barstate.isconfirmed and close >= _slPrice
                resultTime := time_close
                done := true

    [resultTime]


//=========================================================
// TARGET TOUCH: DOTTED TO SOLID
//=========================================================

if setupSaved and levelsDrawn

    if not slLocked
        [sl1mTime] = request.security(
             syminfo.tickerid,
             "1",
             hitStopLoss(
                 setupEndTime,
                 slPrice,
                 direction,
                 checkWindowEnd
                 ),
             lookahead=barmerge.lookahead_off
             )

        if not na(sl1mTime) and not na(slLine)
            line.set_style(slLine, line.style_solid)
            line.set_width(slLine, 1)
            slLocked := true

    // Target touch check on current chart timeframe
    if direction == Direction.BUY

        if time >= setupEndTime and time <= checkWindowEnd and not target1Touched and not na(target1Line)
            if high >= targetPrice - syminfo.mintick * 0.5  // Small tolerance for floating point
                line.set_style(target1Line, line.style_solid)
                line.set_width(target1Line, 1)
                target1Touched := true

        if time >= setupEndTime and time <= checkWindowEnd and not target2Touched and not na(target2Line)
            if high >= target2Price - syminfo.mintick * 0.5
                line.set_style(target2Line, line.style_solid)
                line.set_width(target2Line, 1)
                target2Touched := true

    else

        if time >= setupEndTime and time <= checkWindowEnd and not target1Touched and not na(target1Line)
            if low <= targetPrice + syminfo.mintick * 0.5
                line.set_style(target1Line, line.style_solid)
                line.set_width(target1Line, 1)
                target1Touched := true

        if time >= setupEndTime and time <= checkWindowEnd and not target2Touched and not na(target2Line)
            if low <= target2Price + syminfo.mintick * 0.5
                line.set_style(target2Line, line.style_solid)
                line.set_width(target2Line, 1)
                target2Touched := true


//=========================================================
isEntryBreakoutPrice(_entry, _price, _direction) =>

    _direction == Direction.BUY ? _price > _entry : _price < _entry


//=========================================================
// DIRECT BREAKOUT
//=========================================================

directBreakout(_entry, _setupTime, _direction, _windowEnd) =>

    var bool done = false
    var int resultTime = na
    var float resultPrice = na

    if not na(_setupTime) and time >= _setupTime and time <= _windowEnd and not done

        // Use the confirmed close, so a wick beyond entry alone does not qualify.
        bool valid = isEntryBreakoutPrice(_entry, close, _direction)

        if valid and barstate.isconfirmed
            resultTime := time_close
            resultPrice := close
            done := true

    [resultTime, resultPrice]


//=========================================================
// 1M TWO-CANDLE BREAKOUT CONFIRMATION (BODY ONLY)
//
// Step 1: First 1m candle whose body (open/close) breaks
//         the entry line → mark that candle's body high (BUY)
//         or body low (SELL).
// Step 2: Any subsequent 1m candle (not necessarily the
//         next one) whose body CLOSES beyond the marked
//         body high/low confirms the breakout.
// Wicks are ignored in both steps.
//=========================================================

twoStepBreakout(_entry, _setupTime, _direction, _windowEnd) =>

    var float firstCandleHigh = na   // marked body high of first breaking candle (BUY)
    var float firstCandleLow  = na   // marked body low  of first breaking candle (SELL)
    var bool  firstFound      = false
    var bool  done            = false
    var int   resultTime      = na
    var float resultPrice     = na

    if not na(_setupTime) and time >= _setupTime and time <= _windowEnd and not done

        // Body high/low: the portion of the candle covered by open/close
        float bodyHigh = math.max(open, close)
        float bodyLow  = math.min(open, close)

        if barstate.isconfirmed
            if _direction == Direction.BUY
                // Step 1: candle body breaks above entry
                if not firstFound and bodyHigh > _entry
                    firstCandleHigh := bodyHigh   // mark this candle's BODY high
                    firstFound      := true

                // Step 2: a later candle's body closes above the marked high
                else if firstFound and close > firstCandleHigh
                    resultTime  := time_close
                    resultPrice := close
                    done        := true

            else
                // Step 1: candle body breaks below entry
                if not firstFound and bodyLow < _entry
                    firstCandleLow := bodyLow     // mark this candle's BODY low
                    firstFound     := true

                // Step 2: a later candle's body closes below the marked low
                else if firstFound and close < firstCandleLow
                    resultTime  := time_close
                    resultPrice := close
                    done        := true

    [resultTime, resultPrice]


//=========================================================
// 1M ENTRY BREAKOUT CONFIRMATION (YELLOW)
//=========================================================

oneMinuteEntryBreakout(_entry, _target, _setupEndTime, _direction, _windowEnd) =>

    var bool done = false
    var int resultTime = na
    var float resultPrice = na

    if not na(_setupEndTime) and time >= _setupEndTime and time <= _windowEnd and not done
        
        float bodyHigh = math.max(open, close)
        float bodyLow  = math.min(open, close)
        
        bool breakout = false

        if _direction == Direction.BUY
            breakout := bodyHigh > _entry and close <= _target
        else
            breakout := bodyLow < _entry and close >= _target

        if breakout and barstate.isconfirmed
            resultTime := time
            resultPrice := close
            done := true

    [resultTime, resultPrice]


int yellowConfirmTime = na
float yellowConfirmPrice = na

//=========================================================
// PURPLE CONFIRMATION VARIABLES
//=========================================================

int confirmTimeA = na
float confirmPriceA = na

int confirmTimeB = na
float confirmPriceB = na

int confirmTimeC = na
float confirmPriceC = na


//=========================================================
// 1M SETUP - YELLOW LINE (kept for 1M setup only)
//=========================================================

if setupSaved and levelsDrawn and setupTf == "1"
    [oneMinConfirmTime, oneMinConfirmPrice] = request.security(
         syminfo.tickerid,
         "1",
         oneMinuteEntryBreakout(
             entryPrice,
             targetPrice,
             finalSetupTime,
             direction,
             checkWindowEnd
             ),
         lookahead=barmerge.lookahead_off
         )

    if not na(oneMinConfirmTime) and not na(oneMinConfirmPrice) and oneMinConfirmTime >= setupEndTime and oneMinConfirmTime <= checkWindowEnd
        yellowConfirmTime := oneMinConfirmTime
        yellowConfirmPrice := oneMinConfirmPrice
    else
        yellowConfirmTime := na
        yellowConfirmPrice := na


//=========================================================
// 3M & 5M SETUP - YELLOW & PURPLE
//
// YELLOW: 3M and 5M use a 1M close beyond entry
// PURPLE: 3M setup uses 3M close after setup; 5M setup uses 5M close
//=========================================================

if setupSaved and levelsDrawn and (setupTf == "3" or setupTf == "5")

    [oneMinuteCloseTime, oneMinuteClosePrice] = request.security(
         syminfo.tickerid,
         "1",
         directBreakout(
             entryPrice,
             setupEndTime,
             direction,
             checkWindowEnd
             ),
         lookahead=barmerge.lookahead_off
         )

    if not na(oneMinuteCloseTime) and not na(oneMinuteClosePrice)
        yellowConfirmTime := oneMinuteCloseTime
        yellowConfirmPrice := oneMinuteClosePrice

    if setupTf == "3"
        [threeTime, threePrice] = request.security(
             syminfo.tickerid,
             "3",
             directBreakout(
                 entryPrice,
                 setupEndTime,
                 direction,
                 checkWindowEnd
                 ),
             lookahead=barmerge.lookahead_off,
             gaps=barmerge.gaps_on
             )

        confirmTimeA := threeTime
        confirmPriceA := threePrice
    else
        [fiveTime, fivePrice] = request.security(
             syminfo.tickerid,
             "5",
             directBreakout(
                 entryPrice,
                 purpleCheckStartTime,
                 direction,
                 checkWindowEnd
                 ),
             lookahead=barmerge.lookahead_off,
             gaps=barmerge.gaps_on
             )

        confirmTimeA := fiveTime
        confirmPriceA := fivePrice

    confirmTimeB := na
    confirmPriceB := na

    confirmTimeC := na
    confirmPriceC := na


//=========================================================
// 30M SETUP - PURPLE
//
// 5M SINGLE OR 30M SINGLE
//=========================================================

if setupSaved and levelsDrawn and setupTf == "30"

    [fiveTime30, fivePrice30] = request.security(
         syminfo.tickerid,
         "5",
         directBreakout(
             entryPrice,
             setupEndTime,
             direction,
             checkWindowEnd
             ),
         lookahead=barmerge.lookahead_off
         )

    [thirtyTime, thirtyPrice] = request.security(
         syminfo.tickerid,
         "30",
         directBreakout(
             entryPrice,
             setupEndTime,
             direction,
             checkWindowEnd
             ),
         lookahead=barmerge.lookahead_off
         )

    bool valid5m = false

    if not na(fiveTime30) and not na(fivePrice30)

        valid5m := fiveTime30 > setupEndTime and fiveTime30 <= checkWindowEnd and isEntryBreakoutPrice(
             entryPrice,
             fivePrice30,
             direction
             )

    if valid5m

        confirmTimeA := fiveTime30
        confirmPriceA := fivePrice30

        confirmTimeB := na
        confirmPriceB := na

        confirmTimeC := na
        confirmPriceC := na

    else

        bool valid30m = false

        if not na(thirtyTime) and not na(thirtyPrice)

            valid30m := thirtyTime > setupEndTime and thirtyTime <= checkWindowEnd and isEntryBreakoutPrice(
                 entryPrice,
                 thirtyPrice,
                 direction
                 )

        if valid30m

            confirmTimeA := thirtyTime
            confirmPriceA := thirtyPrice

        else

            confirmTimeA := na
            confirmPriceA := na

        confirmTimeB := na
        confirmPriceB := na

        confirmTimeC := na
        confirmPriceC := na


//=========================================================
// SELECT PURPLE CONFIRMATION
//=========================================================

selectConfirmation(
     _timeA,
     _priceA,
     _timeB,
     _priceB,
     _timeC,
     _priceC,
     _entry,
     _setupTime,
     _windowEnd,
     _direction
     ) =>

    bool validA = false
    bool validB = false
    bool validC = false

    if not na(_timeA) and not na(_priceA)

        bool priceValidA = isEntryBreakoutPrice(_entry, _priceA, _direction)
        validA := _timeA > _setupTime and _timeA <= _windowEnd and priceValidA

    if not na(_timeB) and not na(_priceB)

        bool priceValidB = isEntryBreakoutPrice(_entry, _priceB, _direction)
        validB := _timeB > _setupTime and _timeB <= _windowEnd and priceValidB

    if not na(_timeC) and not na(_priceC)

        bool priceValidC = isEntryBreakoutPrice(_entry, _priceC, _direction)
        validC := _timeC > _setupTime and _timeC <= _windowEnd and priceValidC

    int selectedTime = na
    float selectedPrice = na

    if validA

        selectedTime := _timeA
        selectedPrice := _priceA

    if validB and (na(selectedTime) or _timeB < selectedTime)

        selectedTime := _timeB
        selectedPrice := _priceB

    if validC and (na(selectedTime) or _timeC < selectedTime)

        selectedTime := _timeC
        selectedPrice := _priceC

    [selectedTime, selectedPrice]


//=========================================================
// PURPLE LINE
//=========================================================

var bool breakoutDone = false
var int lockedConfirmTime = na
var float lockedConfirmPrice = na
var bool confirmTargetDrawn = false  // Track if confirm target line is drawn

if setupSaved and levelsDrawn and not breakoutDone

    [selectedTime, selectedPrice] = selectConfirmation(
         confirmTimeA,
         confirmPriceA,
         confirmTimeB,
         confirmPriceB,
         confirmTimeC,
         confirmPriceC,
         entryPrice,
         setupEndTime,
         checkWindowEnd,
         direction
         )

    if not na(selectedTime) and not na(selectedPrice)

        // Check if purple line is within valid range (between entry and target)
        bool validPurpleRange = false
        if direction == Direction.BUY
            validPurpleRange := selectedPrice > entryPrice and selectedPrice <= targetPrice + syminfo.mintick
        else
            validPurpleRange := selectedPrice < entryPrice and selectedPrice >= targetPrice - syminfo.mintick

        if validPurpleRange
            lockedConfirmTime := selectedTime
            lockedConfirmPrice := selectedPrice

            line.new(
                   x1=levelsStartTime,
                 y1=lockedConfirmPrice,
                                 x2=levelsLineEndTime,
                 y2=lockedConfirmPrice,
                   xloc=xloc.bar_time,
                 color=color.purple,
                 width=1,
                 style=line.style_solid,
                   extend=extend.none
                 )

        breakoutDone := true


//=========================================================
// YELLOW LINE (1-minute confirmation)
//=========================================================

if setupSaved and levelsDrawn and not na(yellowConfirmTime) and not na(yellowConfirmPrice) and yellowConfirmTime >= setupEndTime and yellowConfirmTime <= checkWindowEnd and na(yellowLine)

    // Check if yellow line is within valid range (between entry and target)
    bool validYellowRange = false
    if direction == Direction.BUY
        validYellowRange := yellowConfirmPrice > entryPrice and yellowConfirmPrice <= targetPrice + syminfo.mintick
    else
        validYellowRange := yellowConfirmPrice < entryPrice and yellowConfirmPrice >= targetPrice - syminfo.mintick
    
    if validYellowRange
        yellowLinePrice := yellowConfirmPrice

        yellowLine := line.new(
                x1=levelsStartTime,
             y1=yellowConfirmPrice,
                x2=levelsLineEndTime,
             y2=yellowConfirmPrice,
                xloc=xloc.bar_time,
             color=color.rgb(255, 165, 0),  // Dark orange/yellow
             width=1,
             style=line.style_solid,
                extend=extend.none
             )

plot(entryPrice, title="Entry", color=color.blue, display=display.price_scale)
plot(lockedConfirmPrice, title="Purple", color=color.purple, display=display.price_scale)
plot(yellowLinePrice, title="Yellow", color=color.rgb(255, 165, 0), display=display.price_scale)


//=========================================================
// CONFIRM TARGET LINE (based on first confirm line - yellow or purple)
//=========================================================

if setupSaved and levelsDrawn and not confirmTargetDrawn

    // Check which confirm line came first
    int firstConfirmTime = na
    float firstConfirmPrice = na
    
    if not na(yellowConfirmTime) and not na(lockedConfirmTime)
        // Both exist - pick earlier one
        if yellowConfirmTime < lockedConfirmTime
            firstConfirmTime := yellowConfirmTime
            firstConfirmPrice := yellowConfirmPrice
        else
            firstConfirmTime := lockedConfirmTime
            firstConfirmPrice := lockedConfirmPrice
    else if not na(yellowConfirmTime)
        // Only yellow exists
        firstConfirmTime := yellowConfirmTime
        firstConfirmPrice := yellowConfirmPrice
    else if not na(lockedConfirmTime)
        // Only purple exists
        firstConfirmTime := lockedConfirmTime
        firstConfirmPrice := lockedConfirmPrice
    
    // If we have a confirm line, calculate and draw target
    if not na(firstConfirmTime) and not na(firstConfirmPrice)
        
        // Calculate distance from confirm line to SL
        float confirmToSL = math.abs(firstConfirmPrice - slPrice)
        
        // Calculate new target price
        float confirmTargetPrice = na
        if direction == Direction.BUY
            confirmTargetPrice := firstConfirmPrice + confirmToSL
        else
            confirmTargetPrice := firstConfirmPrice - confirmToSL
        
        // Draw confirm target line
        line.new(
                x1=levelsStartTime,
             y1=confirmTargetPrice,
                x2=levelsLineEndTime,
             y2=confirmTargetPrice,
                xloc=xloc.bar_time,
             color=color.rgb(0, 150, 255),  // Light blue
             width=1,
             style=line.style_solid,
                extend=extend.none
             )
        
        confirmTargetDrawn := true
