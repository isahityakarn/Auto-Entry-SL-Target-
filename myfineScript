//@version=6

indicator("Auto Entry SL Target v43", overlay=true, max_lines_count=100, max_labels_count=100, dynamic_requests=true)

enum Direction
    BUY
    SELL

tradeTime = input.string("700", "Candle Time")

direction = input.enum(Direction.BUY, "Direction")

setupTf = input.string(
     "5",
     "Setup Timeframe",
     options=["1", "5", "30"]
     )

setupDate = input.time(
    timestamp("2026-10-07 00:00 +0530"),
    "Setup Date"
    )

string timezone = "Asia/Kolkata"

timeText = str.replace_all(tradeTime, ":", "")
timeValue = int(str.tonumber(timeText))

int hourInput = 0
int minuteInput = 0

if str.length(timeText) <= 2
    hourInput := timeValue
    minuteInput := 0
else
    hourInput := int(timeValue / 100)
    minuteInput := timeValue % 100

setupTimestamp = timestamp(
     timezone,
     year(setupDate, timezone),
     month(setupDate, timezone),
     dayofmonth(setupDate, timezone),
     hourInput,
     minuteInput
     )


//=========================================================
// FIND SETUP CANDLE
//=========================================================

findSetup(_targetTime) =>
    bool found = time == _targetTime
    float setupHigh = found ? high : na
    float setupLow = found ? low : na
    int setupTime = found ? time : na

    [found, setupHigh, setupLow, setupTime]

[setupFoundRaw, setupHighRaw, setupLowRaw, setupTimeRaw] = request.security(syminfo.tickerid, setupTf, findSetup(setupTimestamp), lookahead=barmerge.lookahead_off)


//=========================================================
// SAVE SETUP
//=========================================================

var float finalSetupHigh = na
var float finalSetupLow = na
var int finalSetupTime = na
var bool setupSaved = false

if setupFoundRaw and not setupSaved
    finalSetupHigh := setupHighRaw
    finalSetupLow := setupLowRaw
    finalSetupTime := setupTimeRaw
    setupSaved := true

int setupEndTime = finalSetupTime + timeframe.in_seconds(setupTf) * 1000


//=========================================================
// LEVEL VARIABLES
//=========================================================

var float entryPrice = na
var float slPrice = na
var float targetPrice = na
var float target2Price = na
var float candleRange = na

var bool levelsDrawn = false
var int levelsStartBar = na
var int levelsStartTime = na
var bool slLocked = false
var bool target1Touched = false
var bool target2Touched = false


//=========================================================
// LINE VARIABLES
//=========================================================

var line entryLine = na
var line slLine = na
var line target1Line = na
var line target2Line = na
var line purpleLine = na
var line yellowLine = na


//=========================================================
// CALCULATE & DRAW LEVELS
//=========================================================

if setupSaved and not levelsDrawn

    candleRange := finalSetupHigh - finalSetupLow

    if direction == Direction.BUY

        entryPrice := finalSetupHigh
        slPrice := finalSetupLow

        targetPrice := finalSetupHigh + candleRange
        target2Price := finalSetupHigh + candleRange * 2

    else

        entryPrice := finalSetupLow
        slPrice := finalSetupHigh

        targetPrice := finalSetupLow - candleRange
        target2Price := finalSetupLow - candleRange * 2

    levelsStartBar := bar_index
    levelsStartTime := time

    entryLine := line.new(
            x1=levelsStartTime,
         y1=entryPrice,
            x2=levelsStartTime + 50 * 60 * 1000,
         y2=entryPrice,
            xloc=xloc.bar_time,
         color=color.blue,
         width=3,
         style=line.style_solid,
            extend=extend.none
         )

    slLine := line.new(
            x1=levelsStartTime,
         y1=slPrice,
            x2=levelsStartTime + 50 * 60 * 1000,
         y2=slPrice,
            xloc=xloc.bar_time,
         color=color.red,
         width=3,
         style=line.style_dashed,
            extend=extend.none
         )

    target1Line := line.new(
            x1=levelsStartTime,
         y1=targetPrice,
            x2=levelsStartTime + 50 * 60 * 1000,
         y2=targetPrice,
            xloc=xloc.bar_time,
         color=color.green,
         width=3,
         style=line.style_dashed,
            extend=extend.none
         )

    target2Line := line.new(
            x1=levelsStartTime,
         y1=target2Price,
            x2=levelsStartTime + 50 * 60 * 1000,
         y2=target2Price,
            xloc=xloc.bar_time,
         color=color.orange,
         width=3,
         style=line.style_dashed,
            extend=extend.none
         )

    label.new(
         x=levelsStartBar,
         y=finalSetupHigh,
         text=str.tostring(candleRange, "#.##"),
         style=label.style_none,
         textcolor=color.black,
         size=size.small
         )

    levelsDrawn := true


//=========================================================
// STOP LOSS HIT CHECK
//=========================================================

slStopCheck(_setupEndTime, _slPrice, _direction) =>
    var bool done = false
    var int resultTime = na

    if not na(_setupEndTime) and time >= _setupEndTime and not done
        if _direction == Direction.BUY
            if barstate.isconfirmed and close <= _slPrice
                resultTime := time_close
                done := true
        else
            if barstate.isconfirmed and close >= _slPrice
                resultTime := time_close
                done := true

    [resultTime]


//=========================================================
// TARGET TOUCH: DOTTED TO SOLID
//=========================================================

if setupSaved and levelsDrawn

    if not slLocked
        [sl1mTime] = request.security(
             syminfo.tickerid,
             "1",
             slStopCheck(
                 setupEndTime,
                 slPrice,
                 direction
                 ),
             lookahead=barmerge.lookahead_off
             )

        if not na(sl1mTime) and not na(slLine)
            line.set_style(slLine, line.style_solid)
            line.set_width(slLine, 3)
            slLocked := true

    if direction == Direction.BUY

        if high >= targetPrice and not na(target1Line) and not target1Touched
            line.set_style(target1Line, line.style_solid)
            line.set_width(target1Line, 3)
            target1Touched := true

        if high >= target2Price and not na(target2Line) and not target2Touched
            line.set_style(target2Line, line.style_solid)
            line.set_width(target2Line, 3)
            target2Touched := true

    else

        if low <= targetPrice and not na(target1Line) and not target1Touched
            line.set_style(target1Line, line.style_solid)
            line.set_width(target1Line, 3)
            target1Touched := true

        if low <= target2Price and not na(target2Line) and not target2Touched
            line.set_style(target2Line, line.style_solid)
            line.set_width(target2Line, 3)
            target2Touched := true


//=========================================================
// VALID BREAKOUT PRICE
//=========================================================

isValidBreakoutPrice(_entry, _target, _price, _direction) =>

    bool valid = false

    if _direction == Direction.BUY
        valid := _price > _entry and _price <= _target
    else
        valid := _price < _entry and _price >= _target

    valid


//=========================================================
// DIRECT BREAKOUT
//=========================================================

directBreakout(_entry, _target, _setupTime, _direction) =>

    var bool done = false
    var int resultTime = na
    var float resultPrice = na

    if not na(_setupTime) and time > _setupTime and not done

        bool valid = isValidBreakoutPrice(
             _entry,
             _target,
             close,
             _direction
             )

        if valid and barstate.isconfirmed
            resultTime := time_close
            resultPrice := close
            done := true

    [resultTime, resultPrice]


//=========================================================
// TWO STEP CONFIRMATION
//
// 1M and 3M
//
// First candle:
// Close beyond Entry
//
// Second candle:
// Close beyond first candle close
//=========================================================

confirmTwoStep(_entry, _target, _setupTime, _direction) =>

    var float firstPrice = na
    var bool firstFound = false
    var bool done = false

    var int resultTime = na
    var float resultPrice = na

    if not na(_setupTime) and time > _setupTime and not done

        if _direction == Direction.BUY

            bool firstBreak = close > _entry and close <= _target
            bool secondBreak = firstFound and close > firstPrice and close <= _target

            if not firstFound and firstBreak

                firstFound := true
                firstPrice := close

            else if secondBreak and barstate.isconfirmed

                resultTime := time_close
                resultPrice := close
                done := true

        else

            bool firstBreak = close < _entry and close >= _target
            bool secondBreak = firstFound and close < firstPrice and close >= _target

            if not firstFound and firstBreak

                firstFound := true
                firstPrice := close

            else if secondBreak and barstate.isconfirmed

                resultTime := time_close
                resultPrice := close
                done := true

    [resultTime, resultPrice]


//=========================================================
// 1M ENTRY BREAKOUT CONFIRMATION (YELLOW)
//=========================================================

oneMinuteEntryBreakout(_entry, _target, _setupEndTime, _direction) =>

    var bool done = false
    var int resultTime = na
    var float resultPrice = na

    if not na(_setupEndTime) and time >= _setupEndTime and not done
        bool breakout = false

        if _direction == Direction.BUY
            breakout := close > _entry and close <= _target
        else
            breakout := close < _entry and close >= _target

        if breakout and barstate.isconfirmed
            resultTime := time
            resultPrice := close
            done := true

    [resultTime, resultPrice]


int yellowConfirmTime = na
float yellowConfirmPrice = na

//=========================================================
// PURPLE CONFIRMATION VARIABLES
//=========================================================

int confirmTimeA = na
float confirmPriceA = na

int confirmTimeB = na
float confirmPriceB = na

int confirmTimeC = na
float confirmPriceC = na


if setupSaved and levelsDrawn
    [oneMinConfirmTime, oneMinConfirmPrice] = request.security(
         syminfo.tickerid,
         "1",
         oneMinuteEntryBreakout(
             entryPrice,
             targetPrice,
             setupEndTime,
             direction
             ),
         lookahead=barmerge.lookahead_off
         )

    if not na(oneMinConfirmTime) and not na(oneMinConfirmPrice) and oneMinConfirmTime >= setupEndTime
        yellowConfirmTime := oneMinConfirmTime
        yellowConfirmPrice := oneMinConfirmPrice
    else
        yellowConfirmTime := na
        yellowConfirmPrice := na


//=========================================================
// 5M SETUP - PURPLE
//
// 1M x 2
// OR
// 5M SINGLE
//=========================================================

if setupSaved and levelsDrawn and setupTf == "5"

    // 1M x 2
    [oneTime, onePrice] = request.security(
         syminfo.tickerid,
         "1",
         confirmTwoStep(
             entryPrice,
             targetPrice,
             finalSetupTime,
             direction
             ),
         lookahead=barmerge.lookahead_off
         )

    // 5M single
    [fiveTime, fivePrice] = request.security(
         syminfo.tickerid,
         "5",
         directBreakout(
             entryPrice,
             targetPrice,
             finalSetupTime,
             direction
             ),
         lookahead=barmerge.lookahead_off
         )

    confirmTimeA := oneTime
    confirmPriceA := onePrice

    confirmTimeB := na
    confirmPriceB := na

    confirmTimeC := fiveTime
    confirmPriceC := fivePrice


//=========================================================
// 30M SETUP - PURPLE
//
// 5M SINGLE OR 30M SINGLE
//=========================================================

if setupSaved and levelsDrawn and setupTf == "30"

    [fiveTime30, fivePrice30] = request.security(
         syminfo.tickerid,
         "5",
         directBreakout(
             entryPrice,
             targetPrice,
             finalSetupTime,
             direction
             ),
         lookahead=barmerge.lookahead_off
         )

    [thirtyTime, thirtyPrice] = request.security(
         syminfo.tickerid,
         "30",
         directBreakout(
             entryPrice,
             targetPrice,
             finalSetupTime,
             direction
             ),
         lookahead=barmerge.lookahead_off
         )

    bool valid5m = false

    if not na(fiveTime30) and not na(fivePrice30)

        valid5m := fiveTime30 > finalSetupTime and isValidBreakoutPrice(
             entryPrice,
             targetPrice,
             fivePrice30,
             direction
             )

    if valid5m

        confirmTimeA := fiveTime30
        confirmPriceA := fivePrice30

        confirmTimeB := na
        confirmPriceB := na

        confirmTimeC := na
        confirmPriceC := na

    else

        bool valid30m = false

        if not na(thirtyTime) and not na(thirtyPrice)

            valid30m := thirtyTime > finalSetupTime and isValidBreakoutPrice(
                 entryPrice,
                 targetPrice,
                 thirtyPrice,
                 direction
                 )

        if valid30m

            confirmTimeA := thirtyTime
            confirmPriceA := thirtyPrice

        else

            confirmTimeA := na
            confirmPriceA := na

        confirmTimeB := na
        confirmPriceB := na

        confirmTimeC := na
        confirmPriceC := na


//=========================================================
// SELECT PURPLE CONFIRMATION
//=========================================================

selectConfirmation(
     _timeA,
     _priceA,
     _timeB,
     _priceB,
     _timeC,
     _priceC,
     _entry,
     _target,
    _setupTime,
     _direction
     ) =>

    bool validA = false
    bool validB = false
    bool validC = false

    if not na(_timeA) and not na(_priceA)

        validA := _timeA > _setupTime and isValidBreakoutPrice(
             _entry,
             _target,
             _priceA,
             _direction
             )

    if not na(_timeB) and not na(_priceB)

        validB := _timeB > _setupTime and isValidBreakoutPrice(
             _entry,
             _target,
             _priceB,
             _direction
             )

    if not na(_timeC) and not na(_priceC)

        validC := _timeC > _setupTime and isValidBreakoutPrice(
             _entry,
             _target,
             _priceC,
             _direction
             )

    int selectedTime = na
    float selectedPrice = na

    if validA

        selectedTime := _timeA
        selectedPrice := _priceA

    if validB and (na(selectedTime) or _timeB < selectedTime)

        selectedTime := _timeB
        selectedPrice := _priceB

    if validC and (na(selectedTime) or _timeC < selectedTime)

        selectedTime := _timeC
        selectedPrice := _priceC

    [selectedTime, selectedPrice]


//=========================================================
// PURPLE LINE
//=========================================================

var bool breakoutDone = false
var int lockedConfirmTime = na
var float lockedConfirmPrice = na

if setupSaved and levelsDrawn and not breakoutDone

    [selectedTime, selectedPrice] = selectConfirmation(
         confirmTimeA,
         confirmPriceA,
         confirmTimeB,
         confirmPriceB,
         confirmTimeC,
         confirmPriceC,
         entryPrice,
         targetPrice,
         finalSetupTime,
         direction
         )

    if not na(selectedTime) and not na(selectedPrice)

        lockedConfirmTime := selectedTime
        lockedConfirmPrice := selectedPrice

        purpleLine := line.new(
               x1=levelsStartTime,
             y1=lockedConfirmPrice,
               x2=levelsStartTime + 50 * 60 * 1000,
             y2=lockedConfirmPrice,
               xloc=xloc.bar_time,
             color=color.purple,
             width=3,
             style=line.style_solid,
               extend=extend.none
             )

        breakoutDone := true


//=========================================================
// YELLOW STRONG CANDLE CONFIRMATION LINE
//=========================================================

if setupSaved and levelsDrawn and not na(yellowConfirmTime) and not na(yellowConfirmPrice) and yellowConfirmTime >= setupEndTime and na(yellowLine)

    yellowLine := line.new(
            x1=levelsStartTime,
         y1=yellowConfirmPrice,
            x2=levelsStartTime + 50 * 60 * 1000,
         y2=yellowConfirmPrice,
            xloc=xloc.bar_time,
         color=color.yellow,
         width=3,
         style=line.style_solid,
            extend=extend.none
         )
